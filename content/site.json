  "answers": [
    {
      "id": "qa-jinlou-name",
      "question": "金楼为什么叫“金楼”？原名是什么？",
      "aliases": [
        "金楼为什么叫金楼",
        "金楼原名",
        "赋鹤楼",
        "为什么叫金楼",
        "金楼名字"
      ],
      "keywords": [
        "金楼",
        "原名",
        "赋鹤楼",
        "贴金",
        "泥金",
        "木雕",
        "金漆"
      ],
      "answer": "金楼原名赋鹤楼，是苏丕文所建藏书楼。楼内木作装饰讲究，表面施泥金和贴金，因而有了“金楼”的俗称。可以核对的是建筑形制与工艺，不是“用了多少黄金”一类传说数字。",
      "sourceIds": [
        "sdm-1551"
      ],
      "status": "answered"
    },
    {
      "id": "qa-jinlou-builder",
      "question": "金楼是谁建的？什么时候建？",
      "aliases": [
        "金楼谁建的",
        "金楼什么时候建",
        "金楼建造年代",
        "苏丕文"
      ],
      "keywords": [
        "金楼",
        "建造",
        "年代",
        "苏丕文",
        "嘉庆",
        "道光"
      ],
      "answer": "金楼原名赋鹤楼，清嘉庆、道光年间为苏丕文所建藏书楼。博物馆条目记为单进二层建筑，面阔10.5米、进深11.7米。",
      "sourceIds": [
        "sdm-1551"
      ],
      "status": "answered"
    },
    {
      "id": "qa-zhifangdi-name",
      "question": "职方第的名字从哪来？",
      "aliases": [
        "职方第名字",
        "为什么叫职方第",
        "职方第是谁的",
        "职方第主人"
      ],
      "keywords": [
        "职方第",
        "名字",
        "官职",
        "苏丕文",
        "兵部",
        "牌坊",
        "视履考祥",
        "退让明礼"
      ],
      "answer": "职方第是清代兵部职方员外郎苏丕文的宅第，因他的官职而得名。宅第清嘉庆、道光年间建筑，现存四进；第二进砖石牌坊正面刻“视履考祥”，背面刻“退让明礼”。",
      "sourceIds": [
        "sdm-1576"
      ],
      "status": "answered"
    },
    {
      "id": "qa-nilou-wall",
      "question": "泥楼为什么叫“泥楼”？墙是什么做的？",
      "aliases": [
        "泥楼为什么叫泥楼",
        "泥楼墙",
        "干打垒",
        "泥楼材料",
        "蚝壳墙"
      ],
      "keywords": [
        "泥楼",
        "墙",
        "夯",
        "糯米",
        "干打垒",
        "蚝壳"
      ],
      "answer": "泥楼墙体用泥、沙渗以糯米粉、糖浆夯垒而成，坚韧如石，隔热性能好。它始建于明代，20世纪上半叶屋主改建两廊时引入拱券和罗马柱；后庭院还有蚝壳砌成的壳花墙。",
      "sourceIds": [
        "sdm-1577"
      ],
      "status": "answered"
    },
    {
      "id": "qa-yiyu-school",
      "question": "亦渔遗塾是谁家的？做什么用？",
      "aliases": [
        "亦渔遗塾是什么",
        "亦渔遗塾谁家的",
        "亦渔遗塾用途",
        "苏氏家塾"
      ],
      "keywords": [
        "亦渔遗塾",
        "家塾",
        "书塾",
        "苏氏",
        "三兴堂"
      ],
      "answer": "亦渔遗塾是苏氏三兴堂的家塾，清代建筑，供族中子弟读书。它由三间两廊式房屋和一间明字屋组成，总面阔18米、总进深11.6米；天井墙有灰塑对联“风声入竹有琴意；月影写梅无墨痕”。",
      "sourceIds": [
        "sdm-1579"
      ],
      "status": "answered"
    },
    {
      "id": "qa-niannsiyong",
      "question": "《碧江廿四咏》是什么？壁雕在哪里？",
      "aliases": [
        "碧江廿四咏",
        "廿四咏是什么",
        "二十四咏",
        "壁雕在哪里",
        "岁月留声"
      ],
      "keywords": [
        "廿四咏",
        "二十四咏",
        "壁雕",
        "苏鹤",
        "后花园",
        "清明上河图"
      ],
      "answer": "《碧江廿四咏》由清代碧江名仕苏鹤创作。后花园走廊的“岁月留声”铸铜壁雕以这组诗为蓝本，长23.8米、宽1.5米，描绘19世纪碧江的自然景观、市井生活与农商活动，被称为碧江版“清明上河图”。",
      "sourceIds": [
        "fsxcb-918670"
      ],
      "status": "answered"
    },
